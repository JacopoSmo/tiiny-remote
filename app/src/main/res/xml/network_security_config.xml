<?xml version="1.0" encoding="utf-8"?>
<!-- The Tiiny only speaks plain HTTP on the LAN, so cleartext must be allowed
     (this is exactly what MiniiChat blocked). Traffic stays on the home network or inside WireGuard. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
