<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app's icon: straight to Chat, dictation, Translate (with what's copied) or the Gallery. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="dictate" android:enabled="true" android:icon="@drawable/ic_q_mic"
        android:shortcutShortLabel="@string/sc_dictate_short" android:shortcutLongLabel="@string/sc_dictate">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.tiinyremote" android:targetClass="app.tiinyremote.MainActivity">
            <extra android:name="open" android:value="dictate" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="chat" android:enabled="true" android:icon="@drawable/ic_q_chat"
        android:shortcutShortLabel="@string/sc_chat" android:shortcutLongLabel="@string/sc_chat">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.tiinyremote" android:targetClass="app.tiinyremote.MainActivity">
            <extra android:name="open" android:value="chat" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="translate" android:enabled="true" android:icon="@drawable/ic_q_tr"
        android:shortcutShortLabel="@string/sc_translate_short" android:shortcutLongLabel="@string/sc_translate">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.tiinyremote" android:targetClass="app.tiinyremote.MainActivity">
            <extra android:name="open" android:value="translate_clip" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="gallery" android:enabled="true" android:icon="@drawable/ic_q_gal"
        android:shortcutShortLabel="@string/sc_gallery" android:shortcutLongLabel="@string/sc_gallery">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.tiinyremote" android:targetClass="app.tiinyremote.MainActivity">
            <extra android:name="open" android:value="gallery" />
        </intent>
    </shortcut>
</shortcuts>
